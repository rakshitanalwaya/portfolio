<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= profile.name %> — <%= profile.title %>. Portfolio, projects, experience, and education.">
  <title><%= profile.name %> | <%= profile.title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Work+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="<%= basePath %>css/styles.css">
</head>
<body>
  <script>
    window.PORTFOLIO_BASE_PATH = '<%= basePath %>';
    window.PORTFOLIO_ANALYTICS_ENABLED = <%= analyticsEnabled ? 'true' : 'false' %>;
  </script>
  <div class="page-bg" aria-hidden="true">
    <div class="page-bg__orb page-bg__orb--1"></div>
    <div class="page-bg__orb page-bg__orb--2"></div>
    <div class="page-bg__orb page-bg__orb--3"></div>
    <div class="page-bg__grid"></div>
  </div>

  <header class="site-header" id="top">
    <nav class="nav container" aria-label="Main navigation">
      <a href="#top" class="nav-logo" data-track="nav" data-label="Logo">
        <span class="nav-logo__mark">R</span>
        <span class="nav-logo__text"><%= profile.name.split(' ')[0] %></span>
      </a>
      <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <ul class="nav-links">
        <li><a href="#about" data-track="nav" data-label="About">About</a></li>
        <li><a href="#experience" data-track="nav" data-label="Experience">Experience</a></li>
        <li><a href="#case-studies" data-track="nav" data-label="Case Studies">Case Studies</a></li>
        <li><a href="#ai-projects" data-track="nav" data-label="AI Projects">AI Projects</a></li>
        <li><a href="#education" data-track="nav" data-label="Education">Education</a></li>
        <li><a href="#contact" class="nav-cta" data-track="nav" data-label="Contact">Contact</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <section class="hero section" id="hero">
      <div class="container">
        <div class="hero-grid">
          <div class="hero-content reveal">
            <div class="hero-badge">
              <span class="hero-badge__dot"></span>
              Open to opportunities
            </div>
            <h1 class="hero-name"><%= profile.name %></h1>
            <p class="hero-title"><%= profile.title %></p>
            <p class="hero-tagline"><%= profile.tagline %></p>
            <% if (profile.location) { %>
              <p class="hero-location">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <%= profile.location %>
              </p>
            <% } %>
            <div class="hero-actions">
              <a href="#contact" class="btn btn-primary" data-track="cta" data-label="Get in touch">
                Get in touch
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a href="#ai-projects" class="btn btn-secondary" data-track="cta" data-label="View AI projects">View AI work</a>
              <% if (profile.resumeUrl) { %>
                <a href="<%= assetUrl(profile.resumeUrl) %>" class="btn btn-ghost" target="_blank" rel="noopener noreferrer" data-track="cta" data-label="Download resume">Resume</a>
              <% } %>
            </div>
            <div class="hero-social">
              <% if (profile.github) { %>
                <a href="<%= profile.github %>" target="_blank" rel="noopener noreferrer" data-track="social" data-label="GitHub" aria-label="GitHub">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
                </a>
              <% } %>
              <% if (profile.linkedin) { %>
                <a href="<%= profile.linkedin %>" target="_blank" rel="noopener noreferrer" data-track="social" data-label="LinkedIn" aria-label="LinkedIn">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                </a>
              <% } %>
              <% if (profile.email) { %>
                <a href="mailto:<%= profile.email %>" data-track="social" data-label="Email" aria-label="Email">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                </a>
              <% } %>
            </div>
          </div>

          <div class="hero-panel reveal reveal-delay-1">
            <div class="hero-panel__header">
              <span class="hero-panel__label">At a glance</span>
              <span class="hero-panel__icon" aria-hidden="true">✦</span>
            </div>
            <div class="hero-stats">
              <div class="hero-stat">
                <span class="hero-stat__value">6+</span>
                <span class="hero-stat__label">Years experience</span>
              </div>
              <div class="hero-stat">
                <span class="hero-stat__value">Cornell</span>
                <span class="hero-stat__label">M.Eng Engineering Mgmt</span>
              </div>
              <div class="hero-stat">
                <span class="hero-stat__value">AI + PM</span>
                <span class="hero-stat__label">Product &amp; technical depth</span>
              </div>
            </div>
            <div class="hero-panel__skills">
              <p class="hero-panel__skills-label">Core strengths</p>
              <ul class="skill-pills">
                <% profile.skills.slice(0, 8).forEach(function(skill) { %>
                  <li><%= skill %></li>
                <% }); %>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="about">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-number">01</span>
          <div>
            <p class="eyebrow">Background</p>
            <h2>About me</h2>
          </div>
        </div>
        <div class="about-grid">
          <p class="about-text reveal"><%= profile.about %></p>
          <div class="skills-block reveal reveal-delay-1">
            <h3>Technical skills</h3>
            <ul class="skill-pills skill-pills--full">
              <% profile.skills.forEach(function(skill) { %>
                <li><%= skill %></li>
              <% }); %>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-alt" id="experience">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-number">02</span>
          <div>
            <p class="eyebrow">Career</p>
            <h2>Work experience</h2>
          </div>
        </div>
        <div class="timeline">
          <% 
            var groups = [];
            profile.experience.forEach(function(job) {
              var last = groups[groups.length - 1];
              if (last && last.company === job.company) {
                last.roles.push(job);
              } else {
                groups.push({ company: job.company, location: job.location, roles: [job] });
              }
            });
            groups.forEach(function(group, groupIndex) {
              var isMultiRole = group.roles.length > 1;
          %>
            <article class="timeline-item reveal" style="--delay: <%= groupIndex * 0.1 %>s">
              <div class="timeline-marker">
                <span class="timeline-marker__dot"></span>
              </div>
              <div class="timeline-content card<%= isMultiRole ? ' card--grouped' : '' %>">
                <% if (isMultiRole) { %>
                  <div class="company-group-header">
                    <h3><%= group.company %></h3>
                    <p class="card-subtitle"><%= group.location %></p>
                  </div>
                  <% group.roles.forEach(function(job) { %>
                    <div class="role-block">
                      <div class="card-header">
                        <div>
                          <h4 class="role-title"><%= job.role %></h4>
                        </div>
                        <span class="badge"><%= job.period %></span>
                      </div>
                      <p class="card-description"><%= job.description %></p>
                      <% if (job.achievements && job.achievements.length) { %>
                        <ul class="card-list">
                          <% job.achievements.forEach(function(item) { %>
                            <li><%= item %></li>
                          <% }); %>
                        </ul>
                      <% } %>
                      <% if (job.technologies && job.technologies.length) { %>
                        <ul class="skill-pills skill-pills--compact">
                          <% job.technologies.forEach(function(tech) { %>
                            <li><%= tech %></li>
                          <% }); %>
                        </ul>
                      <% } %>
                    </div>
                  <% }); %>
                <% } else { %>
                  <% var job = group.roles[0]; %>
                  <div class="card-header">
                    <div>
                      <h3><%= job.role %></h3>
                      <p class="card-subtitle"><%= job.company %> · <%= job.location %></p>
                    </div>
                    <span class="badge"><%= job.period %></span>
                  </div>
                  <p class="card-description"><%= job.description %></p>
                  <% if (job.achievements && job.achievements.length) { %>
                    <ul class="card-list">
                      <% job.achievements.forEach(function(item) { %>
                        <li><%= item %></li>
                      <% }); %>
                    </ul>
                  <% } %>
                  <% if (job.technologies && job.technologies.length) { %>
                    <ul class="skill-pills skill-pills--compact">
                      <% job.technologies.forEach(function(tech) { %>
                        <li><%= tech %></li>
                      <% }); %>
                    </ul>
                  <% } %>
                <% } %>
              </div>
            </article>
          <% }); %>
        </div>
      </div>
    </section>

    <% if (profile.caseStudies && profile.caseStudies.length) { %>
    <section class="section section-case-studies" id="case-studies">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-number">03</span>
          <div>
            <p class="eyebrow">Product work</p>
            <h2>Case studies</h2>
          </div>
        </div>
        <p class="section-intro reveal">Deep dives into product challenges I've led — from problem framing through measurable outcomes.</p>
        <div class="case-studies-grid">
          <% profile.caseStudies.forEach(function(study, i) { %>
            <article class="case-study card reveal<%= study.featured ? ' case-study--featured' : '' %>" id="case-<%= study.id %>" style="--delay: <%= i * 0.1 %>s">
              <div class="case-study__body">
              <div class="case-study__header">
                <div class="case-study__meta">
                  <% if (study.category) { %>
                    <span class="project-badge<%= study.featured ? '' : ' project-badge--muted' %>"><%= study.category %></span>
                  <% } %>
                  <h3 class="case-study__title"><%= study.title %></h3>
                  <p class="case-study__company"><%= study.company %> · <%= study.role %></p>
                </div>
                <span class="badge"><%= study.period %></span>
              </div>
              <p class="case-study__summary"><%= study.summary %></p>
              <% if (study.metrics && study.metrics.length) { %>
                <ul class="case-study__metrics">
                  <% study.metrics.forEach(function(metric) { %>
                    <li><%= metric %></li>
                  <% }); %>
                </ul>
              <% } %>
              <div class="case-study__details" id="case-details-<%= study.id %>" hidden>
                <% if (study.challenge) { %>
                  <div class="case-study__block">
                    <h4>Challenge</h4>
                    <p><%= study.challenge %></p>
                  </div>
                <% } %>
                <% if (study.approach) { %>
                  <div class="case-study__block">
                    <h4>Approach</h4>
                    <p><%= study.approach %></p>
                  </div>
                <% } %>
                <% if (study.results) { %>
                  <div class="case-study__block">
                    <h4>Results</h4>
                    <p><%= study.results %></p>
                  </div>
                <% } %>
                <% if (study.highlights && study.highlights.length) { %>
                  <ul class="card-list">
                    <% study.highlights.forEach(function(item) { %>
                      <li><%= item %></li>
                    <% }); %>
                  </ul>
                <% } %>
                <% if (study.technologies && study.technologies.length) { %>
                  <ul class="skill-pills skill-pills--compact">
                    <% study.technologies.forEach(function(tech) { %>
                      <li><%= tech %></li>
                    <% }); %>
                  </ul>
                <% } %>
                <% if (study.documentUrl) { %>
                  <div class="case-study__links">
                    <a href="<%= assetUrl(study.documentUrl) %>" target="_blank" rel="noopener noreferrer" data-track="case-study" data-label="<%= study.title %> — Document" data-section="case-studies">
                      View full case study
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
                    </a>
                  </div>
                <% } %>
              </div>
              </div>
              <button type="button" class="case-study__toggle" aria-expanded="false" aria-controls="case-details-<%= study.id %>" data-track="case-study" data-label="<%= study.title %> — Expand" data-section="case-studies">
                <span class="case-study__toggle-text">Read case study</span>
                <svg class="case-study__toggle-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
              </button>
            </article>
          <% }); %>
        </div>
      </div>
    </section>
    <% } %>

    <% const featuredProjects = profile.projects.filter(function(p) { return p.featured; }); %>
    <% if (featuredProjects.length) { %>
    <section class="section section-ai" id="ai-projects">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-number">04</span>
          <div>
            <p class="eyebrow">Artificial Intelligence</p>
            <h2>AI project spotlight</h2>
          </div>
        </div>
        <p class="section-intro reveal">Hands-on AI implementation — from agentic news aggregation with LLMs to NLP and data mining projects.</p>
        <div class="projects-grid projects-grid--featured">
          <% featuredProjects.forEach(function(project, i) { %>
            <article class="card project-card project-card--featured reveal" style="--delay: <%= i * 0.12 %>s">
              <div class="project-card__glow" aria-hidden="true"></div>
              <div class="project-badge"><%= project.category || 'AI' %></div>
              <h3><%= project.name %></h3>
              <p class="card-description"><%= project.description %></p>
              <% if (project.highlights && project.highlights.length) { %>
                <ul class="card-list">
                  <% project.highlights.forEach(function(item) { %>
                    <li><%= item %></li>
                  <% }); %>
                </ul>
              <% } %>
              <ul class="skill-pills skill-pills--compact">
                <% project.technologies.forEach(function(tech) { %>
                  <li><%= tech %></li>
                <% }); %>
              </ul>
              <div class="project-links">
                <% if (project.github) { %>
                  <a href="<%= project.github %>" target="_blank" rel="noopener noreferrer" data-track="project" data-label="<%= project.name %> — GitHub">
                    View code
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
                  </a>
                <% } %>
                <% if (project.live) { %>
                  <a href="<%= project.live %>" target="_blank" rel="noopener noreferrer" data-track="project" data-label="<%= project.name %> — Live demo">Live demo</a>
                <% } %>
              </div>
            </article>
          <% }); %>
        </div>
      </div>
    </section>
    <% } %>

    <% if (profile.honors && profile.honors.length) { %>
    <section class="section" id="honors">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-number">—</span>
          <div>
            <p class="eyebrow">Recognition</p>
            <h2>Honors &amp; awards</h2>
          </div>
        </div>
        <div class="cards-grid">
          <% profile.honors.forEach(function(item) { %>
            <article class="card reveal">
              <div class="card-header">
                <div>
                  <h3><%= item.title %></h3>
                  <p class="card-subtitle"><%= item.organization %></p>
                </div>
                <span class="badge"><%= item.period %></span>
              </div>
              <p class="card-description"><%= item.description %></p>
            </article>
          <% }); %>
        </div>
      </div>
    </section>
    <% } %>

    <section class="section section-alt" id="education">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-number">05</span>
          <div>
            <p class="eyebrow">Academics</p>
            <h2>Education</h2>
          </div>
        </div>
        <div class="cards-grid">
          <% profile.education.forEach(function(edu, i) { %>
            <article class="card reveal" style="--delay: <%= i * 0.1 %>s">
              <div class="card-header">
                <div>
                  <h3><%= edu.degree %></h3>
                  <p class="card-subtitle"><%= edu.institution %> · <%= edu.location %></p>
                </div>
                <span class="badge"><%= edu.period %></span>
              </div>
              <% if (edu.gpa) { %>
                <p class="card-meta">GPA: <%= edu.gpa %></p>
              <% } %>
              <% if (edu.highlights && edu.highlights.length) { %>
                <ul class="card-list">
                  <% edu.highlights.forEach(function(item) { %>
                    <li><%= item %></li>
                  <% }); %>
                </ul>
              <% } %>
            </article>
          <% }); %>
        </div>
      </div>
    </section>

    <section class="section contact-section" id="contact">
      <div class="container">
        <div class="contact-card reveal">
          <div class="contact-card__content">
            <div class="section-header section-header--light">
              <span class="section-number section-number--light">06</span>
              <div>
                <p class="eyebrow eyebrow--light">Connect</p>
                <h2>Let's build something meaningful</h2>
              </div>
            </div>
            <p class="contact-text">I'm open to product management and AI-focused roles. The fastest way to reach me is by email or LinkedIn.</p>
          </div>
          <div class="contact-actions">
            <% if (profile.phone) { %>
              <a href="tel:<%= profile.phone.replace(/[^+\d]/g, '') %>" class="contact-link" data-track="contact" data-label="Phone">
                <span class="contact-link__icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </span>
                <span class="contact-link__body">
                  <span class="contact-link-label">Phone</span>
                  <span class="contact-link-value"><%= profile.phone %></span>
                </span>
              </a>
            <% } %>
            <% if (profile.email) { %>
              <a href="mailto:<%= profile.email %>" class="contact-link" data-track="contact" data-label="Email">
                <span class="contact-link__icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                </span>
                <span class="contact-link__body">
                  <span class="contact-link-label">Email</span>
                  <span class="contact-link-value"><%= profile.email %></span>
                </span>
              </a>
            <% } %>
            <% if (profile.linkedin) { %>
              <a href="<%= profile.linkedin %>" class="contact-link" target="_blank" rel="noopener noreferrer" data-track="contact" data-label="LinkedIn">
                <span class="contact-link__icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                </span>
                <span class="contact-link__body">
                  <span class="contact-link-label">LinkedIn</span>
                  <span class="contact-link-value">Connect on LinkedIn</span>
                </span>
              </a>
            <% } %>
            <% if (profile.github) { %>
              <a href="<%= profile.github %>" class="contact-link" target="_blank" rel="noopener noreferrer" data-track="contact" data-label="GitHub">
                <span class="contact-link__icon" aria-hidden="true">
